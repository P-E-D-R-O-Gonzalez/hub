---
import Layout from '../layouts/Layout.astro';
import Weather from '../components/Weather.astro';
import FontanaFeed from '../components/FontanaFeed.astro';
const localMediaDocument = `<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Local Media</title>
<style>body { margin: 0; padding: 16px; font-family: Arial, sans-serif; }</style></head>
<body>
<div class="elfsight-app-8c88e705-f902-456f-9f41-89a508b557be" data-elfsight-app-lazy></div>
<script src="https://elfsightcdn.com/platform.js" async></script>
</body></html>`;
---

<Layout>
  <div id="homepage-background" aria-hidden="true"></div>
  <div class="hub">
    <header>
      <h1>Fontana Aware</h1>
      <time id="date">Date</time>
      <time id="clock">Time</time>
      <Weather />
    </header>
    <main aria-label="Hub boxes">
      <section id="box-1" class="box" aria-labelledby="card-title-1">
        <div class="card-content">
          <h2 id="card-title-1">Fontana Calendar</h2>
          <p class="card-description">Meetings, agendas and attachments.</p>
          <div class="card-actions"><a class="card-action" href="https://fontana.legistar.com/Calendar.aspx" target="_blank" rel="noopener noreferrer">View calendar</a></div>
        </div>
        
      </section>
      <section id="box-2" class="box" aria-labelledby="card-title-2">
        <div class="card-content">
          <h2 id="card-title-2">Traffic Cameras</h2>
          <p class="card-description">Check nearby road conditions.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-1" aria-expanded="false">Load Traffic Cams</button>
          <a class="source-link" href="https://trafficvision.live/?state=California&search=Fontana" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a></div>
        </div>
        <iframe id="frame-1" data-src="https://trafficvision.live/?state=California&search=Fontana" title="Traffic cameras" hidden></iframe>
      </section>
      <section id="box-3" class="box" aria-labelledby="card-title-3">
        <div class="card-content">
          <h2 id="card-title-3">On Demand Videos</h2>
          <p class="card-description">Watch recorded city programs.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-2" aria-expanded="false">Load Videos</button>
          <a class="source-link" href="https://watchkfon.fontana.org/internetchannel/gallery/2?site=1&channel=1" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a></div>
        </div>
        <iframe id="frame-2" data-src="https://watchkfon.fontana.org/internetchannel/gallery/2?site=1&channel=1" title="On demand videos" hidden></iframe>
      </section>
      <section id="box-4" class="box" aria-labelledby="card-title-4">
        <div class="card-content">
          <h2 id="card-title-4">Fontana Data</h2>
          <p class="card-description">Explore city maps and public data.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-3" aria-expanded="false">Load City Data</button>
          <a class="source-link" href="https://data.fontanaca.gov/" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a></div>
        </div>
        <iframe id="frame-3" data-src="https://arcg.is/01ejfO0" title="City open data" hidden></iframe>
      </section>
      <section id="box-5" class="box" aria-labelledby="card-title-5">
        <div class="card-content">
          <h2 id="card-title-5">Flock Map</h2>
          <p class="card-description">Find mapped camera locations.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-4" aria-expanded="false">Load Flock map</button>
          <a class="source-link" href="https://maps.deflock.org/?lat=34.0923&lng=-117.4343&zoom=11.00" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a></div>
        </div>
        <iframe id="frame-4" data-src="https://maps.deflock.org/?lat=34.0923&lng=-117.4343&zoom=11.00" title="Flock map" hidden></iframe>
      </section>
      <section id="box-6" class="box" aria-labelledby="card-title-6">
        <div class="card-content">
          <h2 id="card-title-6">Fontana TV</h2>
          <p class="card-description">Watch the local city broadcast.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-5" aria-expanded="false">Load Fontana TV</button>
          <a class="source-link" href="https://watchkfon.fontana.org/internetchannel/watch-now?site=1&channel=1" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a></div>
        </div>
        <iframe id="frame-5" data-src="https://watchkfon.fontana.org/internetchannel/watch-now?site=1&channel=1" title="Fontana TV" hidden></iframe>
      </section>
      <section id="box-7" class="box" aria-labelledby="card-title-7">
        <div class="card-content">
          <h2 id="card-title-7">Local Groups</h2>
          <p class="card-description">Discover local news and groups.</p>
          <div class="card-actions"><a class="card-action" href="/localgroups/">Browse groups</a></div>
        </div>
        
      </section>
      <section id="box-8" class="box" aria-labelledby="card-title-8">
        <div class="card-content">
          <h2 id="card-title-8">Local Media</h2>
          <p class="card-description">Browse updates from local sources.</p>
          <div class="card-actions"><button type="button" class="load-frame" aria-controls="frame-6" aria-expanded="false">Load Local Media</button></div>
        </div>
        <iframe id="frame-6" data-srcdoc={localMediaDocument} title="Local Media" hidden></iframe>
      </section>
    </main>
    <footer>
      <nav aria-label="Community links">
     <a href="https://www.fontana311.org/s/" target="_blank">Report a city issue</a>
     <a href="https://forms.gle/iPsVVdThTcscaAPo7" target="_blank">Send feedback</a>
          <a href="get-involved" target="_blank">Get involved</a>
          </nav>
    </footer>
  </div>
</Layout>

<script>
  const frameButtons = document.querySelectorAll<HTMLButtonElement>('.load-frame');
  frameButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const frame = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!(frame instanceof HTMLIFrameElement) || (!frame.dataset.src && !frame.dataset.srcdoc)) return;

      const opening = frame.hidden;
      if (opening) {
        frameButtons.forEach((otherButton) => {
          if (otherButton === button) return;
          const otherFrame = document.getElementById(otherButton.getAttribute('aria-controls') ?? '');
          if (!(otherFrame instanceof HTMLIFrameElement) || otherFrame.hidden) return;
          otherFrame.hidden = true;
          otherFrame.closest('.box')?.classList.remove('is-expanded');
          otherButton.setAttribute('aria-expanded', 'false');
          otherButton.textContent = `Open ${otherFrame.title}`;
        });
      }
      if (opening && !frame.hasAttribute('src') && !frame.hasAttribute('srcdoc')) {
        if (frame.dataset.srcdoc) frame.srcdoc = frame.dataset.srcdoc;
        else if (frame.dataset.src) frame.src = frame.dataset.src;
      }
      frame.hidden = !opening;
      frame.closest('.box')?.classList.toggle('is-expanded', opening);
      button.setAttribute('aria-expanded', String(opening));
      button.textContent = `${opening ? 'Close' : 'Open'} ${frame.title}`;
      if (opening) {
        requestAnimationFrame(() => {
          if (frame.hidden) return;
          frame.closest('.box')?.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
            block: 'start',
          });
        });
      }
    });
  });

  const date = document.querySelector<HTMLTimeElement>('#date');
  const clock = document.querySelector<HTMLTimeElement>('#clock');
  function updateClock() {
    const now = new Date();
    if (date && clock) {
      date.textContent = now.toLocaleDateString(undefined, {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
      });
      clock.textContent = now.toLocaleTimeString(undefined, {
        hour: '2-digit', minute: '2-digit',
      });
      date.dateTime = clock.dateTime = now.toISOString();
    }
  }
  updateClock();
  window.setInterval(updateClock, 1000);
</script>

<style>

  a
  {
    color:black;
  }
  a:hover
  {
    color:blue;
  }
  a:visited
  {
    color:#777f73;
  }
  #homepage-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #e2eff6 0%,
      #edf3f6 45%,
      #f5f6f7 100%
    );
  }
  .hub {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(16px, 3vw, 40px);
    background: transparent;
    color: #242724;
    font-family: Arial, Helvetica, sans-serif;
  }
  header, footer {
    border: 1px solid #d9dcd6;
    background: #fff;
    border-radius: 12px;
    padding: 24px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: clamp(14px, 1.5vw, 20px);
  }
  #clock { font-variant-numeric: tabular-nums; }
  main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
  }
  .box {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d9e1e6;
    border-radius: 12px;
    background: #fff;
    color: #242724;
    scroll-margin-top: 20px;
  }
  .card-content {
    box-sizing: border-box;
    height: 100%;
    min-height: 210px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .card-content h2 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }
  .card-description {
    margin: 0 0 24px;
    color: #59656e;
    font-size: 14px;
    line-height: 1.5;
  }
  .card-actions {
    min-height: 80px;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .load-frame, .card-action {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid #596650;
    border-radius: 8px;
    background: #f5f5f3;
    color: #242724;
    font: 600 14px/1.4 Arial, Helvetica, sans-serif;
    text-decoration: none;
    cursor: pointer;
  }
  .load-frame:hover, .card-action:hover {
    background: #e7ebe3;
    color: #242724;
  }
  .source-link { font-size: 13px; text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible {
    outline: 3px solid #426b88;
    outline-offset: 4px;
  }
  .box.is-expanded { order: 1; grid-column: 1 / -1; }
  .box.is-expanded .card-content { height: auto; min-height: 0; }
  .box iframe {
    display: block;
    width: 100%;
    height: clamp(360px, 65vh, 800px);
    min-height: 360px;
    border: 0;
    border-top: 1px solid #d9e1e6;
  }
  .box iframe[hidden] { display: none; }
  @media (min-width: 1200px) {
    main { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .card-content { padding: 20px; }
    .card-actions { align-items: flex-start; flex-direction: column; }
    .box.is-expanded .card-actions { flex-direction: row; align-items: center; }
  }
  @media (max-width: 767px) {
    main { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
  footer { font-size: 14px; }
  footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 32px;
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 4px;
    line-height: 1.5;
  }
</style>

