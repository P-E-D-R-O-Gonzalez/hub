---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
import BackToSite from '../components/BackToSite.astro';
import policy from '../data/privacy-policy.html?raw';
---

<Layout>
  <main class="privacy-policy">
    <header>
      <Brand />
      <nav aria-label="Return to site"><BackToSite /></nav>
      <h1>Privacy Policy</h1>
    </header>
    <article lang="en" translate="no" aria-label="Privacy policy text" set:html={policy} />
  </main>
</Layout>

<style>
  .privacy-policy { box-sizing: border-box; min-height: 100svh; padding: clamp(16px, 3vw, 40px); background: var(--water-page); color: var(--water-ink); font-family: Arial, Helvetica, sans-serif; line-height: 1.6; }
  header, article { box-sizing: border-box; max-width: 960px; margin: 0 auto 20px; padding: clamp(20px, 4vw, 36px); border: 1px solid var(--water-border); border-radius: 12px; background: white; overflow-wrap: anywhere; }
  nav { margin-top: 16px; }
  h1 { margin-bottom: 0; }
  article { overflow-x: auto; }
  article :global(table) { max-width: 100%; }
  article :global([id]) { scroll-margin-top: 20px; }
  .privacy-policy :global(a:focus-visible) { outline: 3px solid var(--water-blue); outline-offset: 3px; }
</style>
