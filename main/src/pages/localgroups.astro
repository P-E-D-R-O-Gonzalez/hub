---
import Layout from '../layouts/Layout.astro';


interface GroupEntry {
  name: string;
  link: string;
  summary: string;
}

interface GroupSection {
  id: string;
  title: string;
  entries: GroupEntry[];
}

// Add groups to each entries list using:
// { name: 'Group name', link: 'https://example.com', summary: 'About the group.' }
const sections: GroupSection[] = [
  { id: 'news', title: 'Local News Groups', 
  entries: [{name:"Fontana Herald News",link:"https://fontanaheraldnews.com", summary:"local newspaper based in Fontana, California, serving the community with news, sports, and local events. The publication has been in operation since 1923 and is currently managed by Gerald Beam."},{name:"Newsflash",link:"https://www.fontanaca.gov/m/newsflash?cat=1",summary:"Fontana's newsletter"}, {name:"Fontana News Now",link:"https://www.facebook.com/p/Fontana-News-NOW-61561945724636/",summary:"Fontana native and long-time journalist informs Fontana residents about their city and community at large. Please also subscribe to fontananewsnow at Youtube. Have a story idea? Email fontananewsnow@gmail.com"}] },
  { id: 'climate-change', title: 'Climate Change Groups', entries: [] },
  { id: 'religious', title: 'Religious Groups', entries: [] },
  { id: 'immigration', title: 'Immigration Groups', entries: [] },
];
---

<Layout>
  <div class="local-groups">
    <header>
      <a href="/">Back to Fontana Aware</a>
      <h1>Local Groups</h1>
      <p>Explore groups and ways to get involved in your community.</p>
    </header>
    <main>
      <div class="section-picker">
        <label for="group-section">Choose a section</label>
        <select id="group-section" aria-controls="group-information">
          <option value="">Select a section</option>
          {sections.map((section) => <option value={section.id}>{section.title}</option>)}
        </select>
      </div>
      <div id="group-information" aria-live="polite" aria-atomic="true">
        <p id="selection-hint">Choose a section above to see its information.</p>
        {sections.map((section) => (
          <section data-group-section={section.id} aria-labelledby={`${section.id}-heading`} hidden>
            <h2 id={`${section.id}-heading`}>{section.title}</h2>
            {section.entries.length > 0 ? (
              <ul class="group-entries">
                {section.entries.map((entry) => (
                  <li>
                    <h3>
                      {entry.link ? <a href={entry.link}>{entry.name}</a> : entry.name}
                    </h3>
                    <p>{entry.summary}</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="placeholder">No groups have been added to this section yet.</p>
            )}
          </section>
        ))}
      </div>
      <noscript>Enable JavaScript to select and view a group section.</noscript>
    </main>
  </div>
</Layout>

<script>
  const select = document.querySelector<HTMLSelectElement>('#group-section');
  const sections = document.querySelectorAll<HTMLElement>('[data-group-section]');
  const hint = document.querySelector<HTMLElement>('#selection-hint');

  function showSelectedSection() {
    if (!select) return;
    sections.forEach((section) => {
      section.hidden = section.dataset.groupSection !== select.value;
    });
    if (hint) hint.hidden = select.value !== '';
  }

  select?.addEventListener('change', showSelectedSection);
  window.addEventListener('pageshow', showSelectedSection);
  showSelectedSection();
</script>

<style>
  .local-groups {
    box-sizing: border-box;
    min-height: 100svh;
    padding: clamp(16px, 3vw, 40px);
    background: #f5f5f3;
    color: #242724;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  header, main {
    box-sizing: border-box;
    max-width: 960px;
    margin: 0 auto 20px;
    padding: clamp(20px, 4vw, 36px);
    border: 1px solid #d9dcd6;
    border-radius: 12px;
    background: #fff;
  }
  a { color: #46553d; }
  h1 { margin: 16px 0 8px; font-size: clamp(28px, 5vw, 48px); line-height: 1.2; }
  h2 { margin-top: 0; line-height: 1.3; }
  p { margin: 0 0 16px; }
  .section-picker { display: grid; gap: 8px; margin-bottom: 24px; }
  label { font-weight: 600; }
  select {
    box-sizing: border-box;
    width: 100%;
    padding: 12px;
    border: 1px solid #777f73;
    border-radius: 8px;
    background: #fff;
    color: #242724;
    font: inherit;
  }
  select:focus-visible, a:focus-visible { outline: 3px solid #596650; outline-offset: 3px; }
  [hidden] { display: none; }
  .group-entries { list-style: none; margin: 0; padding: 0; }
  .group-entries li { padding: 20px 0; border-top: 1px solid #d9dcd6; overflow-wrap: anywhere; }
  .group-entries h3 { margin: 0 0 8px; }
  .group-entries p { margin: 0; }
  .placeholder, #selection-hint { color: #596650; }
</style>
