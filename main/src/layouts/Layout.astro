---
import LanguageToggle from '../components/LanguageToggle.astro';
import brandingContent from '../data/branding.json';
import { readBranding } from '../lib/branding';
const branding = readBranding(brandingContent);
import '../styles/water.css';
// Validate CMS translations during the build as well as loading them in the browser.
import '../lib/translations';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{branding.favicon ? <link rel="icon" href={branding.favicon} /> : <>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		</>}
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f4fbff" />
		<meta name="application-name" content="Fontana Aware" />
		<meta name="apple-mobile-web-app-title" content="Fontana Aware" />
		<meta name="generator" content={Astro.generator} />
		<title>Fontana Aware</title>
	</head>
	<body>
		<LanguageToggle />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
