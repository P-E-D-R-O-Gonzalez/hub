---
import content from '../data/instagram.json';
import { readInstagramSources } from '../lib/instagram';
const defaultSources = readInstagramSources(content);
---

<div class="instagram-viewer" data-defaults={JSON.stringify(defaultSources)}>
  <div class="intro">
  </div>
  <p id="source-message" role="status" aria-live="polite"></p>
  <div class="feed-toolbar" hidden>
    <label for="instagram-filter">Show</label>
    <select id="instagram-filter"><option value="">All sources</option></select>
    <button type="button" class="refresh">Refresh feeds</button>
  </div>
  <p class="empty water-panel">No Instagram sources are configured yet.</p>
  <div class="feed-loading" role="status" hidden><span class="loading-spinner" aria-hidden="true"></span><span>Loading local media…</span></div>
  <div class="feed-grid"></div>
  <p class="embed-note">If a feed is unavailable or asks you to sign in, use “View on Instagram”.</p>
  <noscript>Enable JavaScript to view Instagram feeds.</noscript>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.instagram-viewer')!;
  if (root) {
  const message = root.querySelector<HTMLElement>('[role="status"]')!;
  const filter = root.querySelector<HTMLSelectElement>('select')!;
  const grid = root.querySelector<HTMLElement>('.feed-grid')!;
  const toolbar = root.querySelector<HTMLElement>('.feed-toolbar')!;
  const empty = root.querySelector<HTMLElement>('.empty')!;
  const sources: string[] = JSON.parse(root.dataset.defaults || '[]');

  const loading = root.querySelector<HTMLElement>('.feed-loading')!;
  const note = root.querySelector<HTMLElement>('.embed-note')!;
  let cancelLoading = () => {};

  function render() {
    const selected = sources.includes(filter.value) ? filter.value : '';
    filter.replaceChildren(new Option(`All sources (${sources.length})`, ''));
    sources.forEach(source => filter.add(new Option(`@${source}`, source)));
    filter.value = selected;
    toolbar.hidden = sources.length === 0;
    empty.hidden = sources.length > 0;
    grid.replaceChildren();
    for (const source of sources) {
      const card = document.createElement('article');
      card.className = 'feed-card water-panel';
      card.dataset.source = source;
      card.hidden = !!selected && selected !== source;
      const head = document.createElement('div');
      head.className = 'feed-card-heading';
      const heading = document.createElement('h4');
      heading.textContent = `@${source}`;
      head.append(heading);
      const link = document.createElement('a');
      link.href = `https://www.instagram.com/${source}/`;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = 'View on Instagram ↗';
      const frame = document.createElement('iframe');
      frame.title = `Instagram feed from @${source}`;
      frame.dataset.src = `https://www.instagram.com/${source}/embed/`;
      frame.loading = 'eager';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      card.append(head, link, frame);
      grid.append(card);
    }
    loadVisible();
  }
  function loadVisible(refresh = false) {
    cancelLoading();
    if (root.closest('[hidden]')) return;
    const frames = [...grid.querySelectorAll<HTMLIFrameElement>('.feed-card:not([hidden]) iframe')];
    const pending = frames.filter(frame => refresh || !frame.hasAttribute('src'));
    if (!pending.length) return;
    loading.hidden = false;
    grid.hidden = true;
    toolbar.hidden = true;
    note.hidden = true;
    grid.setAttribute('aria-busy', 'true');
    message.textContent = '';
    const timeout = window.setTimeout(() => cancelLoading(), 8000);
    cancelLoading = () => {
      window.clearTimeout(timeout);
      loading.hidden = true;
      grid.hidden = false;
      toolbar.hidden = sources.length === 0;
      note.hidden = false;
      grid.setAttribute('aria-busy', 'false');
    };
    for (const frame of pending) {
      frame.src = frame.dataset.src!;
    }
  }

  filter.addEventListener('change', () => {
    grid.querySelectorAll<HTMLElement>('.feed-card').forEach(card => { card.hidden = !!filter.value && card.dataset.source !== filter.value; });
    loadVisible();
  });
  root.querySelector('.refresh')!.addEventListener('click', () => loadVisible(true));
  root.parentElement?.addEventListener('panel-open', () => loadVisible());
  root.parentElement?.addEventListener('panel-close', () => cancelLoading());
  render();
  }
</script>

<style>
  .instagram-viewer { border-top: 1px solid var(--water-border); padding: clamp(16px, 3vw, 24px); background: var(--water-page); }
  h3 { margin: 0 0 8px; font-size: 21px; }
  p { color: var(--water-muted); font-size: 14px; line-height: 1.6; }
  .intro p { margin: 0 0 20px; }
  label { font-size: 14px; font-weight: 600; }
  select, button { box-sizing: border-box; min-height: 44px; border: 1px solid var(--water-border); border-radius: 8px; padding: 10px 12px; font: inherit; color: var(--water-ink); background: white; }
  button { cursor: pointer; background: var(--water-page); font-weight: 600; }
  button:hover { background: var(--water-hover); }
  :is(select, button):focus-visible { outline: 3px solid var(--water-blue); outline-offset: 3px; }
  #source-message:empty { display: none; }
  .feed-toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 20px 0; }
  select { max-width: 100%; }
  .empty { padding: 28px; border: 1px dashed var(--water-border); border-radius: 10px; text-align: center; background: white; }
  .feed-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; align-items: start; }
  .feed-grid :global(.feed-card) { min-width: 0; padding: 16px; border: 1px solid var(--water-border); border-radius: 10px; background: white; overflow: hidden; }
  .feed-grid :global(.feed-card-heading) { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .feed-grid :global(h4) { margin: 0; overflow-wrap: anywhere; font-size: 16px; }
  .feed-grid :global(a) { display: inline-block; margin: 12px 0; color: var(--water-blue); font-size: 14px; }
  .feed-grid :global(iframe) { display: block; width: 100%; height: 560px; border: 0; background: var(--water-page); }
  .feed-grid :global(a:focus-visible) { outline: 3px solid var(--water-blue); outline-offset: 3px; }
  [hidden], .feed-grid :global([hidden]) { display: none; }
  .feed-loading { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 180px; color: inherit; font-size: 15px; }
  .loading-spinner { width: 26px; height: 26px; border: 3px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: media-spin 0.8s linear infinite; }
  @keyframes media-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .loading-spinner { animation: none; } }
  .embed-note { margin-bottom: 0; }
  @media (max-width: 480px) { .feed-grid :global(.feed-card) { padding: 10px; } }
</style>
