---
import brandingContent from '../data/branding.json';
import { readBranding } from '../lib/branding';
const branding = readBranding(brandingContent);
---
<a class="brand" href="/" aria-label={branding.logoAlt} translate="no">
  {branding.logo ? <img src={branding.logo} alt={branding.logoAlt} width="240" height="112" /> : branding.logoAlt}
</a>
<style>
.brand { display: inline-block; max-width: 100%; color: inherit; }
img { display: block; width: 240px; max-width: 100%; height: 112px; object-fit: contain; }
</style>
