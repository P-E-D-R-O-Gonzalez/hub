---
import brandingContent from '../data/branding.json';
import { readBranding } from '../lib/branding';
const branding = readBranding(brandingContent);
---
<a class="brand" href="/" aria-label={branding.logoAlt} translate="no">
  <img class:list={{ custom: !!branding.logo }} src={branding.logo || "/android-chrome-512x512.png"} alt={branding.logoAlt} width="240" height="112" />
</a>

<style>
  .brand { display: inline-block; max-width: 100%; vertical-align: middle; border-radius: 8px; background: white; }
  img { display: block; width: 240px; max-width: 100%; height: 112px; object-fit: cover; object-position: center 56%; border-radius: inherit; }
  img.custom { object-fit: contain; object-position: center; }
  .brand:focus-visible { outline: 3px solid #426b88; outline-offset: 4px; }
</style>
