---
import Parser from 'rss-parser';

const feedUrl = 'https://www.fontanaca.gov/RSSFeed.aspx?ModID=76&CID=All-0';
let entries: { title: string; link: string; date: Date | null }[] = [];
let unavailable = false;
try {
  const response = await fetch(feedUrl, { signal: AbortSignal.timeout(15000) });
  if (!response.ok) throw new Error(`RSS returned ${response.status}`);
  const feed = await new Parser().parseString(await response.text());
  entries = feed.items.flatMap((item) => {
    if (!item.link) return [];
    try {
      const link = new URL(item.link, feedUrl);
      if (!['http:', 'https:'].includes(link.protocol)) return [];
      const date = new Date(item.isoDate || item.pubDate || '');
      return [{ title: item.title?.trim() || 'Fontana update', link: link.href,
        date: Number.isNaN(date.getTime()) ? null : date }];
    } catch { return []; }
  }).slice(0, 20);
} catch (error) {
  unavailable = true;
  console.warn('Fontana RSS feed unavailable:', error);
}
const retrieved = new Date();
---

<div class="feed">
  <h2>Fontana updates</h2>
  <p class="source">City website RSS &middot; <a href={feedUrl}>View feed</a></p>
  <div class="feed-items" tabindex="0" role="region" aria-label="Latest Fontana website updates">
    {unavailable ? <p>Updates are temporarily unavailable. <a href="https://www.fontanaca.gov/">Visit the city website</a>.</p>
      : entries.length === 0 ? <p>No updates in the feed yet.</p>
      : <ul>{entries.map((entry) => (
          <li>
            <a href={entry.link} target="_blank" rel="noopener noreferrer">{entry.title}</a>
            {entry.date && <time datetime={entry.date.toISOString()}>{entry.date.toLocaleDateString('en-US', {
              month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles',
            })}</time>}
          </li>
        ))}</ul>}
  </div>
  {!unavailable && <p class="source">Feed loaded {retrieved.toLocaleString('en-US', { timeZone: 'America/Los_Angeles', timeZoneName: 'short' })}</p>}
</div>

<style>
  .feed { box-sizing: border-box; width: 100%; min-width: 0; padding: 20px; color: #242724; font-size: 14px; font-weight: 400; }
  h2 { margin: 0 0 6px; font-size: 20px; }
  .source { margin: 6px 0; color: #62685e; font-size: 11px; }
  .feed-items { max-height: 240px; overflow-y: auto; overscroll-behavior: contain; margin-top: 12px; }
  .feed-items:focus-visible { outline: 2px solid #42663c; outline-offset: 3px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 10px 0; border-bottom: 1px solid #e5e7e2; }
  li:first-child { padding-top: 0; }
  a { color: #365c30; text-underline-offset: 3px; overflow-wrap: anywhere; }
  li a { font-weight: 600; line-height: 1.4; }
  time { display: block; margin-top: 4px; color: #62685e; font-size: 12px; }
</style>
