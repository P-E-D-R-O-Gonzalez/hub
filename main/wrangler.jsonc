{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fontanaware.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/auth", "/api/callback"]
  },
  "vars": {
    "SITE_ORIGIN": "https://fontanaware.org",
    "GITHUB_CLIENT_ID": "Ov23livhkZh1mSWf08qg"
  }
}
